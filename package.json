{
  "name": "@elgavio/sdk",
  "version": "0.1.0",
  "description": "The Elgavio delivery API client, with generated content types and the elgavio CLI",
  "license": "MIT",
  "type": "module",
  "prettier": "@elgavioapp/code-quality/prettier.json",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "elgavio": "./dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/fixture",
    "lint": "oxlint --type-aware --report-unused-disable-directives-severity=error --max-warnings=0 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version": "node scripts/write-version.ts && git add src/version.ts",
    "update:code-quality": "npm install @elgavioapp/code-quality@latest --min-release-age=0",
    "generate:api": "node --env-file-if-exists=.env scripts/generate-api.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elgavioapp/elgavio-sdk.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@elgavioapp/code-quality": "^0.3.0",
    "@types/node": "^24.19.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
